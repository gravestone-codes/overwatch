---
import Site from "@/layouts/Site.astro";
import PageHead from "@/components/site/PageHead.astro";
import ServicesBand from "@/components/site/ServicesBand.astro";
import Routes from "@/components/site/Routes.astro";
import { services } from "@/data/company";
import { contactHref } from "@/data/site";
---

<Site title="Services" description="Installation, managed operations, support and training from the engineers who build Overwatch Labs products.">
  <PageHead title="Help around every product." lede="Ark Cloud runs on our servers, and the engineers who build it support you. When OmniArk opens, our technicians can install it on your premises or run it for you.">
    <a class="btn btn-solid" href={contactHref("general")}>Ask a question</a>
    <a class="btn btn-line" href={contactHref("omniark")}>Join the OmniArk waiting list</a>
  </PageHead>

  <ServicesBand lede="Ark Cloud and Pillar run on our servers. OmniArk will run on yours, and you choose how much to hand over." />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">What each service covers.</h2>
        <p>For OmniArk, when it opens.</p>
      </div>
      <div class="points" style="--cols: 3">
        {
          services.map((s) => (
            <div id={s.id} style="scroll-margin-top: 6rem">
              <h3 class="h3">{s.title}</h3>
              <p>{s.body}</p>
              <ul class="ticks">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
              <p class="label" style="margin-top: 1.25rem">{s.price}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Routes />
</Site>
