---
import Site from "@/layouts/Site.astro";
import PageHead from "@/components/site/PageHead.astro";
import { site } from "@/data/site";
---

<Site title="Privacy notice" description="How Overwatch Labs handles the personal information you share through this website.">
  <PageHead title="Privacy notice." lede="How we handle what you share through this website. It's short, because we collect very little." />
  <section class="section tight">
    <div class="wrap">
      <div class="prose">
        <h2>What we collect</h2>
        <p>When you fill in a form on this site, we receive what you type: your name, work email, phone number if you give it, your organisation, and anything you choose to tell us. We also count page visits anonymously to understand which pages are useful. We don't use advertising cookies.</p>
        <h2>Why we use it</h2>
        <p>Only to answer your request: to arrange a demo, set up a trial, prepare a quote or follow up on your readiness check. We never sell your information or share it for marketing.</p>
        <h2>How long we keep it</h2>
        <p>For as long as we're in conversation with you, and no longer than that purpose or the law requires.</p>
        <h2>Your choices</h2>
        <p>You can ask us to show, correct or delete the information we hold about you at any time by writing to <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <h2>Our products</h2>
        <p>This notice covers this website only. Our products run on your own systems; the data they protect stays with you and never comes to us unless you choose to send it.</p>
      </div>
    </div>
  </section>
</Site>
