---
import Site from "@/layouts/Site.astro";
import PageHead from "@/components/site/PageHead.astro";
import Lineup from "@/components/site/Lineup.astro";
import Routes from "@/components/site/Routes.astro";

const principles = [
  { title: "Proof over promises", body: "We don't ask you to trust that something works. Our products show you, every day." },
  { title: "You stay in control", body: "Your data, your keys, your premises. Nothing leaves unless you choose." },
  { title: "Built to last", body: "We build for years of service under real pressure, not for a demo." },
  { title: "Engineers, not ticket queues", body: "The people who build the product answer when you call, and come on site when it's serious." },
];
---

<Site title="About us" description="Overwatch Labs designs, builds and runs software for the institutions people depend on. The engineers who build our products are the ones who support them.">
  <PageHead
    title="Software that has to keep working."
    lede="Overwatch Labs designs, builds and runs software for the institutions people depend on. The engineers who build our products are the ones who support them."
  >
    <a class="btn btn-solid" href="#products">See our products</a>
    <a class="btn btn-line" href="/careers">Careers</a>
  </PageHead>

  <section class="section tight">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">What we make.</h2>
        <p>One product is available today and two are in development. Each has its own site.</p>
      </div>
      <Lineup />
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">How we work.</h2>
      </div>
      <div class="points" style="--cols: 4">
        {
          principles.map((p) => (
            <div>
              <h3 class="h3">{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Routes title="Talk to the people who build it." />
</Site>
