---
import Site from "@/layouts/Site.astro";
import Lineup from "@/components/site/Lineup.astro";
import ServicesBand from "@/components/site/ServicesBand.astro";
import Sectors from "@/components/site/Sectors.astro";
import Routes from "@/components/site/Routes.astro";
---

<Site
  title="Overwatch Labs · We design, build and run software products"
  description="Overwatch Labs designs, builds and runs software products. OmniArk, for backup and recovery, is available today; Ark Cloud and OWL are in development."
>
  <section class="hero">
    <div class="wrap">
      <div class="split">
        <h1>We design, build and run software products.</h1>
        <div>
          <p class="lede">Overwatch Labs’ first product, OmniArk, protects backups and recovery today, with more in development. Our engineers stay with every customer after the sale.</p>
          <div class="actions">
            <a class="btn btn-solid" href="#products">See our products</a>
            <a class="btn btn-line" href="#contact">Talk to us</a>
          </div>
        </div>
      </div>
      <Lineup />
    </div>
  </section>

  <ServicesBand />

  <section class="section" id="industries">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Who our products are for.</h2>
        <p>Organisations of every size, in every sector. Each industry page covers what matters most there.</p>
      </div>
      <Sectors />
    </div>
  </section>

  <Routes />
</Site>
