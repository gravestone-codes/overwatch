---
import Site from "@/layouts/Site.astro";
import PageHead from "@/components/site/PageHead.astro";
import Routes from "@/components/site/Routes.astro";
import { products, offsite, waitlistHref } from "@/data/company";
import { site, contactHref } from "@/data/site";

// Ark Cloud's rates, as published on arkcloud.online. Each is per GB a month.
const rates = [
  { what: "Memory, while awake", price: "8,000 RWF" },
  { what: "Disk", price: "200 RWF" },
  { what: "Buckets", price: "200 RWF" },
  { what: "CPU", price: "Free for now" },
  { what: "Builds and traffic", price: "Free for now" },
];
const waiting = [
  ...products.filter((p) => !p.available).map((p) => ({
    mark: p.name.slice(0, 2),
    colour: p.key,
    name: p.name,
    body: p.key === "oa" ? "Priced per protected system, with support, training and updates included." : p.line,
    href: waitlistHref(p.key),
  })),
  { mark: "+", colour: "oa", name: offsite.full, body: offsite.line, href: offsite.href },
];
const faq = [
  { q: "When does billing start?", a: "It hasn't started, so nothing is charged yet. Ark Cloud's Usage page shows what you've used and what it would cost." },
  { q: "What do I pay when nobody visits my app?", a: "After 10 minutes with no visits, your app sleeps, and the next visit wakes it. While it sleeps, you pay only for storage." },
  { q: "How is usage counted?", a: "By the minute. Memory counts only while a service runs. Builds, CPU and traffic are free for now." },
  { q: "When will OmniArk, Pillar and OWL be priced?", a: "When each one opens. Join its waiting list and you'll hear first." },
];
---

<Site title="Pricing" description="Ark Cloud is counted by the minute in Rwandan francs, and billing hasn't started yet. OmniArk, Pillar and OWL will be priced when they open.">
  <PageHead title="Pricing." lede="Ark Cloud is open, counted by the minute in Rwandan francs. Our other products will be priced when they open." />

  <section class="section tight">
    <div class="wrap price-grid">
      <div class="licence c-ac">
        <h2 class="h3"><span class="mark c-ac">Ar</span>Ark Cloud</h2>
        <p>Per GB a month. Billing hasn't started, so nothing is charged yet.</p>
        <dl class="ledger">
          {rates.map((r) => <div><dt>{r.what}</dt><dd>{r.price}</dd></div>)}
        </dl>
        <div class="actions">
          <a class="btn btn-light" href={site.arkcloudUrl} target="_blank" rel="noopener">Start on Ark Cloud</a>
          <a class="btn btn-line" href={`${site.arkcloudUrl}/docs#pricing`} target="_blank" rel="noopener">How pricing works</a>
        </div>
      </div>

      <div class="card">
        <h2 class="h3">For a class or team.</h2>
        <p style="margin-top: 0.5rem">Classrooms with starter projects and deadlines. Students push their code and get a live link, from any laptop.</p>
        <ul class="ticks" style="margin-top: 1.25rem; display: grid; gap: 0.5rem">
          <li>We help you set up your class or team</li>
          <li>The same prices, counted by the minute</li>
          <li>An app that sleeps pays only for storage</li>
        </ul>
        <div class="actions" style="margin-top: 2rem">
          <a class="btn btn-solid" href={contactHref("ark")}>Talk to us</a>
          <a class="btn btn-line" href={`${site.arkcloudUrl}/education`} target="_blank" rel="noopener">Ark Cloud for education</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">On the waiting list.</h2>
        <p>Priced when they open.</p>
      </div>
      <div class="rows">
        {
          waiting.map((w) => (
            <div class="row">
              <h3 class="h3"><span class={`mark c-${w.colour}`}>{w.mark}</span>{w.name}</h3>
              <p>{w.body}</p>
              <a class="price" href={w.href}>Join the waiting list</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap faq-grid">
      <h2 class="h2">Pricing questions.</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details name="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Routes />
</Site>
