---
import Site from "@/layouts/Site.astro";
import PageHead from "@/components/site/PageHead.astro";
import { site } from "@/data/site";
---

<Site title="Sign in" description="Sign in to Overwatch Labs products." noindex>
  <PageHead title="Sign in." lede="Ark Cloud accounts are open. OmniArk, Pillar and OWL have waiting lists, and their accounts open with them.">
    <a class="btn btn-solid" href={`${site.arkcloudUrl}/login`}>Sign in to Ark Cloud</a>
    <a class="btn btn-line" href={`mailto:${site.email}`}>Email us</a>
  </PageHead>
</Site>
