---
import "@/styles/site.css";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { site } from "@/data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes("Overwatch Labs") ? title : `${title} · Overwatch Labs`;
const ogImage = new URL("/og.png", site.url).href;
const home = new URL("/", site.url).href;
const structured = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#organization`,
      name: site.name,
      url: home,
      logo: { "@type": "ImageObject", url: new URL("/logo.png", site.url).href, width: 512, height: 512 },
      description: "Overwatch Labs designs, builds and runs software products. Its first product, OmniArk, is backup and recovery software.",
      foundingDate: site.founded,
      email: site.email,
      telephone: site.phone,
      // The company's official profiles, so search engines connect them to this site.
      sameAs: [site.linkedin, site.x],
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: site.name,
      url: home,
      publisher: { "@id": `${home}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f1f3f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1412" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <script is:inline>
      try {
        const t = localStorage.getItem("ow-theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Martian+Mono:wdth,wght@75..112.5,300..600&family=Schibsted+Grotesk:wght@500..900&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="logo" viewBox="0 0 256 256">
        <rect class="logo-bg" width="256" height="256" rx="60"></rect>
        <g class="logo-fg" transform="translate(44 40) scale(0.66)">
          <path d="M52 27 H80 V41 H114 V27 H142 V41 H176 V27 H204 V55 H52 Z"></path>
          <rect x="46" y="53" width="164" height="16" rx="2"></rect>
          <path fill-rule="evenodd" d="M62 69 L74 99 V163 L60 181 V197 H196 V181 L182 163 V99 L194 69 Z M114 159 V123 A14 14 0 0 1 142 123 V159 Z"></path>
          <rect x="54" y="195" width="148" height="18" rx="2"></rect>
          <rect x="40" y="211" width="176" height="18" rx="3"></rect>
        </g>
      </symbol>
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      <symbol id="out" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      <symbol id="chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      <symbol id="check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      <symbol id="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></symbol>
      <symbol id="sun" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path></g></symbol>
    </svg>

    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <div class="scrim" id="scrim" hidden></div>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />

    <script>
      const root = document.documentElement;

      // Theme: the system setting decides until someone chooses; the header button and the menu switch stay in step.
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-set-theme]");
      const current = () => root.dataset.theme || (prefersDark.matches ? "dark" : "light");
      const showTheme = () => themeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setTheme === current())));
      function setTheme(t: string) {
        root.dataset.theme = t;
        try {
          localStorage.setItem("ow-theme", t);
        } catch (e) {}
        showTheme();
      }
      document.getElementById("theme-toggle")?.addEventListener("click", () => setTheme(current() === "dark" ? "light" : "dark"));
      themeButtons.forEach((b) => b.addEventListener("click", () => setTheme(b.dataset.setTheme!)));
      prefersDark.addEventListener("change", showTheme);
      showTheme();

      // Phone and tablet menu: a card under the bar, the page behind it blurred and locked.
      const toggle = document.getElementById("menu-toggle")!;
      const mnav = document.getElementById("mnav")!;
      const scrim = document.getElementById("scrim")!;
      function setMenu(open: boolean) {
        mnav.hidden = !open;
        scrim.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        root.style.overflow = open ? "hidden" : "";
      }
      toggle.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
      mnav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !mnav.hidden) {
          setMenu(false);
          toggle.focus();
        }
      });
      document.addEventListener("pointerdown", (e) => {
        if (!mnav.hidden && !mnav.contains(e.target as Node) && !toggle.contains(e.target as Node)) setMenu(false);
      });
      window.matchMedia("(min-width: 64.0625rem)").addEventListener("change", (e) => {
        if (e.matches) setMenu(false);
      });

      // The footer wordmark fills the width of the page exactly.
      const wordmark = document.getElementById("wordmark");
      function fitWordmark() {
        if (!wordmark) return;
        const text = wordmark.firstElementChild as HTMLElement;
        wordmark.style.fontSize = "100px";
        const width = text.getBoundingClientRect().width;
        if (width) wordmark.style.fontSize = `${(100 * wordmark.clientWidth) / width}px`;
      }
      fitWordmark();
      document.fonts.ready.then(fitWordmark);
      window.addEventListener("resize", fitWordmark);
    </script>
  </body>
</html>
