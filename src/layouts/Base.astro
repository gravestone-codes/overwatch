---
import "@styles/global.css";
import WaitlistModal from "@components/WaitlistModal.astro";

interface Props {
  title?: string;
  description?: string;
  theme?: "light";
  warm?: boolean;
}

const {
  title = "Overwatch Labs · Infrastructure that observes, protects, endures",
  description = "Overwatch Labs designs and builds the systems other systems depend on: network configuration governance, stream-native backup, and managed resilience.",
  theme,
  warm = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme} data-warm={warm ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem("owl-theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <WaitlistModal />

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const el = document.documentElement;
        const next = el.dataset.theme === "light" ? "dark" : "light";
        if (next === "dark") {
          delete el.dataset.theme;
        } else {
          el.dataset.theme = "light";
        }
        localStorage.setItem("owl-theme", next);
      });
    </script>

    <script>
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
