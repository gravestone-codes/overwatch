---
import Logo from "@components/Logo.astro";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink/70 backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="https://overwatchlabs.dev" class="flex items-center gap-3" aria-label="Overwatch Labs home">
      <Logo size={24} />
      <span class="font-display text-sm font-semibold tracking-[0.28em] text-fog"
        >OVERWATCH</span
      >
      <span class="text-dim">/</span>
      <span class="font-display text-sm font-semibold text-fog">{name}</span>
    </a>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle light and dark mode"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-line text-mute transition-colors hover:border-white/25 hover:text-fog"
      >
        <svg class="only-dark h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="only-light h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button
        type="button"
        data-waitlist={name}
        class="rounded-full bg-fog px-4 py-1.5 text-[13px] font-semibold text-ink transition-opacity hover:opacity-85"
      >
        Join waitlist
      </button>
    </div>
  </div>
</header>
