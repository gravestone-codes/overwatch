---
import { industries, moreSectors } from "@/data/industries";
import { productByKey, offerItems } from "@/data/company";

interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
// Rows for sectors without a page sit after the industry named in `after`, even when that industry is the one left out.
const rows = industries.flatMap((i) => [i, ...moreSectors.filter((m) => m.after === i.slug)]).filter((i) => !("slug" in i) || i.slug !== exclude);
---

<div class="sectors">
  <div class="sector-row is-head" aria-hidden="true">
    <span class="label">Industry</span><span class="label">What matters there</span><span class="label">Products</span><span></span>
  </div>
  {
    rows.map((i) => {
      if (!("slug" in i)) {
        const p = productByKey(i.product);
        return (
          <a class="sector-row" href={i.href} target="_blank" rel="noopener">
            <h3>{i.name}</h3>
            <p>{i.matters}</p>
            <div class="chips">
              <span class:list={["chip label", `c-${p.key}`, !p.available && "is-soon"]}>{p.name}{!p.available && ", soon"}</span>
            </div>
            <svg class="go" width="18" height="18" aria-hidden="true"><use href="#out" /></svg>
          </a>
        );
      }
      return (
        <a class="sector-row" href={`/industries/${i.slug}`}>
          <h3>{i.row}</h3>
          <p>{i.matters}</p>
          <div class="chips">
            {offerItems(i.offer).map((o) => (
              <span class:list={["chip label", `c-${o.colour}`, !o.available && "is-soon"]}>{o.chip}{!o.available && ", soon"}</span>
            ))}
          </div>
          <svg class="go" width="18" height="18" aria-hidden="true"><use href="#arrow" /></svg>
        </a>
      );
    })
  }
</div>
