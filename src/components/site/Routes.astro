---
import { site, contactHref } from "@/data/site";

interface Props {
  title?: string;
  lede?: string;
}
const { title = "Tell us what you need.", lede = "A real person usually replies within one working day." } = Astro.props;
const routes = [
  { title: "Start on Ark Cloud", body: "Connect a repository and get a link.", href: site.arkcloudUrl, primary: true },
  { title: "Ark Cloud for a class or team", body: "We'll help you set it up.", href: contactHref("ark") },
  { title: "Join a waiting list", body: "OmniArk, Pillar and OWL.", href: "/contact" },
  { title: "Ask a question", body: "About anything we make.", href: contactHref("general") },
];
---

<section class="section panel-bg" id="contact">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 class="h2">{title}</h2>
      <p>{lede}</p>
      <dl class="reach">
        <div><dt class="label">Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt class="label">Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
      </dl>
    </div>
    <ul class="routes">
      {
        routes.map((r) => (
          <li>
            <a class:list={["route", r.primary && "is-primary"]} href={r.href}>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
              <span class="arr"><svg width="16" height="16" aria-hidden="true"><use href="#arrow" /></svg></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
